# Client-side only. Vite inlines every VITE_* variable into the bundle, so never
# put a secret behind this prefix. Server secrets live in Supabase function
# secrets and Vault, not here.
VITE_SUPABASE_URL=https://wvtbstticnactealupph.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# This file only feeds local builds. CI reads the same two names from GitHub
# repository variables, so changing a value here does not change what ships.

# Telegram bot username, no @. Absent in builds that ship without the bot;
# the preferences screen then shows the raw /start command instead of a link.
VITE_TELEGRAM_BOT=
